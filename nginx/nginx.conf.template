# nginx 边缘层配置模板（OpenResty 1.31.1.1）
# 由镜像 entrypoint（/usr/local/bin/gateway-entrypoint）用 envsubst 渲染：
#   envsubst '${BACKEND_HOST}' < 本文件 > /usr/local/openresty/nginx/conf/nginx.conf
# 模板变量仅 ${BACKEND_HOST}（upstream 端口硬编码 8080，对应 gateway 服务）
# 注意：entrypoint 每次启动都会覆盖渲染结果，直接挂 nginx.conf 无效，必须挂本模板

worker_processes auto;

# 容器内日志走 stderr / stdout，docker logs 可见
error_log stderr notice;

# 让 worker 内 os.getenv 能读到这些环境变量（lua/redis_conn.lua、ratelimit.lua 使用）
env REDIS_HOST;
env REDIS_PORT;
env RATE_LIMIT_RPS;
env RATE_LIMIT_CAP;

events {
    worker_connections 1024;
}

http {
    access_log /dev/stdout;

    # Docker 内置 DNS：redis_conn.lua 的 cosocket 用主机名（redis）连 Redis 时按此解析
    resolver 127.0.0.11 ipv6=off;

    # OpenResty lualib（lua-resty-redis）+ 本项目 lua 脚本（挂载到 /etc/nginx/lua）
    lua_package_path "/usr/local/openresty/lualib/?.lua;/etc/nginx/lua/?.lua;;";

    upstream backend {
        server ${BACKEND_HOST}:8080;
        keepalive 16;
    }

    server {
        listen 80;

        location / {
            # 按客户端 IP 令牌桶限流（Redis EVAL），超限返 429
            access_by_lua_file /etc/nginx/lua/ratelimit.lua;
            proxy_pass http://backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";   # 配合 upstream keepalive
        }

        location /health {
            return 200 'ok';
        }
    }
}
